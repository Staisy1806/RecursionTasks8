
#include <iostream>
using namespace std;

class Program
{
public:

    // Перевірка зростання
    static int CheckIncreasing(int arr[], int size, int index)
    {
        if (index == size - 1)
            return index;

        if (arr[index] >= arr[index + 1])
            return index;

        return CheckIncreasing(arr, size, index + 1);
    }

    // Перевірка спадання
    static bool CheckDecreasing(int arr[], int size, int index)
    {
        if (index == size - 1)
            return true;

        if (arr[index] <= arr[index + 1])
            return false;

        return CheckDecreasing(arr, size, index + 1);
    }

    // Перевірка гірського масиву
    static bool ValidMountainArray(int arr[], int size)
    {
        if (size < 3)
            return false;

        int peak = CheckIncreasing(arr, size, 0);

        if (peak == 0 || peak == size - 1)
            return false;

        return CheckDecreasing(arr, size, peak);
    }
};

int main()
{
    int arr[] = { 0, 3, 2, 1 };

    int size = sizeof(arr) / sizeof(arr[0]);

    cout << boolalpha;
    cout << Program::ValidMountainArray(arr, size);

    return 0;
}
